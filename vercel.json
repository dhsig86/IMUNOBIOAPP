{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://ottopwa.vercel.app https://otto.drdariohart.com https://*.vercel.app https://*.netlify.app" }
      ]
    }
  ]
}
